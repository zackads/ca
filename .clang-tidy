Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  misc-*,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -cert-err33-c,
  -misc-include-cleaner,
  -misc-no-recursion
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
